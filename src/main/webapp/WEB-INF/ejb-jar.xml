<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns="http://java.sun.com/xml/ns/javaee"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
      	  http://java.sun.com/xml/ns/javaee/ejb-jar_3_1.xsd"
      version="3.1">
    <enterprise-beans>
        <session>
         <ejb-name>ConsumersContainer</ejb-name>
         <ejb-class>ejbs.ConsumersContainer</ejb-class>
         <session-type>Singleton</session-type>
         <timer>
            <schedule>
                <second>*/10</second>
                <minute>*</minute>
                <hour>*</hour>
            </schedule>
            <timeout-method>
                <method-name>checkConsumersStatus</method-name>
            </timeout-method>
         </timer>
        </session>
    </enterprise-beans>
</ejb-jar>

